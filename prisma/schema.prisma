generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id           String    @id @default(uuid(7)) @db.Uuid
  controllerId String    @db.Uuid
  gameTypeId   String    @db.Uuid
  startedAt    DateTime  @db.Timestamptz(3)
  endedAt      DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  controller Controller @relation(fields: [controllerId], references: [id], onDelete: Restrict)
  gameType   GameType   @relation(fields: [gameTypeId], references: [id], onDelete: Restrict)
  data       GameData[]

  @@index([controllerId])
  @@index([gameTypeId])
  @@map("game")
}

model GameType {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  requiredWidth  Int      @db.SmallInt
  requiredHeight Int      @db.SmallInt
  minPlayers     Int      @db.SmallInt
  maxPlayers     Int      @db.SmallInt
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  games Game[]

  @@map("game_type")
}

model GameData {
  id        String   @id @default(uuid(7)) @db.Uuid
  gameId    String   @db.Uuid
  x         Int      @db.SmallInt
  y         Int      @db.SmallInt
  colorHex  String   @db.Char(7)
  led       Int      @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, x, y])
  @@index([gameId])
  @@map("game_data")
}

model Controller {
  id        String   @id @default(uuid(7)) @db.Uuid
  location  String   @db.VarChar(200)
  name      String   @db.VarChar(100)
  width     Int      @db.SmallInt
  height    Int      @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  games Game[]

  @@map("controller")
}
