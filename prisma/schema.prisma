generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id           String    @id @default(uuid(7)) @db.Uuid
  controllerId String    @db.Uuid
  gameTypeId   String    @db.Uuid
  startedAt    DateTime  @db.Timestamptz(3)
  endedAt      DateTime? @db.Timestamptz(3)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  controller Controller @relation(fields: [controllerId], references: [id], onDelete: Restrict)
  gameType   GameType   @relation(fields: [gameTypeId], references: [id], onDelete: Restrict)
  data       GameData[]

  @@index([controllerId])
  @@index([gameTypeId])
  @@map("game")
}

model GameType {
  id             String   @id @default(uuid(7)) @db.Uuid
  key            String   @unique @db.VarChar(50)
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  requiredWidth  Int      @db.SmallInt
  requiredHeight Int      @db.SmallInt
  minPlayers     Int      @db.SmallInt
  maxPlayers     Int      @db.SmallInt
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  games        Game[]
  playRequests PlayRequest[]

  @@map("game_type")
}

model GameData {
  id        String   @id @default(uuid(7)) @db.Uuid
  gameId    String   @db.Uuid
  x         Int      @db.SmallInt
  y         Int      @db.SmallInt
  colorHex  String   @db.Char(7)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, x, y])
  @@index([gameId])
  @@map("game_data")
}

model Controller {
  id         String   @id @default(uuid(7)) @db.Uuid
  hardwareId Int      @unique
  location   String   @db.VarChar(200)
  name       String   @db.VarChar(100)
  width      Int      @db.SmallInt
  height     Int      @db.SmallInt
  latitude   Float?   @db.DoublePrecision
  longitude  Float?   @db.DoublePrecision
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  games        Game[]
  playRequests PlayRequest[]

  @@map("controller")
}

// "Looking to play": a user offers to play a game at a controller at a given
// time and says how many others can join.
model PlayRequest {
  id           String   @id @default(uuid(7)) @db.Uuid
  hostId       String
  controllerId String   @db.Uuid
  gameTypeId   String   @db.Uuid
  startsAt     DateTime @db.Timestamptz(3)
  endsAt       DateTime @db.Timestamptz(3)
  // Seats for others, excluding the host.
  openSlots    Int      @db.SmallInt
  note         String?  @db.VarChar(200)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  host         User                     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  controller   Controller               @relation(fields: [controllerId], references: [id], onDelete: Cascade)
  gameType     GameType                 @relation(fields: [gameTypeId], references: [id], onDelete: Cascade)
  participants PlayRequestParticipant[]

  @@index([endsAt])
  @@index([hostId])
  @@index([controllerId])
  @@index([gameTypeId])
  @@map("play_request")
}

model PlayRequestParticipant {
  playRequestId String   @db.Uuid
  userId        String
  joinedAt      DateTime @default(now()) @db.Timestamptz(3)

  playRequest PlayRequest @relation(fields: [playRequestId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([playRequestId, userId])
  @@index([userId])
  @@map("play_request_participant")
}

// Models required by better-auth: https://better-auth.com/docs/concepts/database
// Note: User accounts might be removed in the future. This is just a requirement for the package for now.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  playRequests       PlayRequest[]
  playParticipations PlayRequestParticipant[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(3)
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}
