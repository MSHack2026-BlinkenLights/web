# Copy to ".env" and fill in. Keep in sync with "src/env.js".

# Better Auth secret, e.g. output of `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public app URL, e.g. "https://lights.example.com"
# BETTER_AUTH_URL=""

# Postgres connection for local dev, e.g. "postgresql://postgres:password@localhost:5432/web-blinkin-lights"
DATABASE_URL="postgresql://postgres:password@localhost:5432/web-blinkin-lights"

# Host port the app is published on, e.g. 8080
APP_PORT=3000
# Host interface to bind, e.g. 127.0.0.1 for local only
APP_HOST=0.0.0.0
# Port the server listens on inside the container, e.g. 3000
PORT=3000

# Postgres container user, e.g. postgres
POSTGRES_USER=postgres
# Postgres container password, e.g. output of `openssl rand -hex 16`
POSTGRES_PASSWORD=password
# Postgres database name, e.g. web-blinkin-lights
POSTGRES_DB=web-blinkin-lights
# Host port for Postgres on 127.0.0.1, e.g. 5432 (0 = random)
DB_PORT=0
